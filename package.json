{
  "name": "smart-resizer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "nodemon",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "nodemonConfig": {
    "watch": ["app/api", "app/lib", "next.config.ts"],
    "ext": "ts,tsx,js,json",
    "ignore": [".next/**", "node_modules/**", "public/**"],
    "exec": "next dev",
    "delay": "500",
    "env": { "NODE_ENV": "development" }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "next": "^16.2.3",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.33.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "nodemon": "^3.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
